# Server port (default: 3000)
PORT=3000

# Session TTL in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# Max WebSocket message size in bytes — signaling only, NO file payload (default: 16 KB)
MAX_MSG_BYTES=16384

# Max simultaneous sessions in memory (default: 50 000)
MAX_SESSIONS=50000

# Max WebSocket messages per minute per device (rate limiting)
RATE_LIMIT_PER_MIN=120

# CORS origin for /health — only if another site must read it (default: none;
# the web client is served from this same server)
CORS_ORIGIN=

# Extra origins allowed to open the WebSocket, comma-separated (default: only
# this site itself; the CLI sends no Origin and is always allowed)
ALLOWED_ORIGINS=

# Set to 1 when a reverse proxy (Caddy, nginx…) sits in front: the client IP is
# taken from X-Forwarded-For and HSTS is sent for HTTPS requests (default: off)
TRUST_PROXY=

# Max simultaneous WebSocket connections per client IP (default: 20)
MAX_CONN_PER_IP=20
