# Server port (default: 3000)
PORT=3000

# Session TTL in milliseconds (default: 30 minutes)
SESSION_TTL_MS=1800000

# Max WebSocket message size in bytes — signaling only, NO file payload (default: 16 KB)
MAX_MSG_BYTES=16384

# Max simultaneous sessions in memory (default: 50 000)
MAX_SESSIONS=50000

# Max WebSocket messages per minute per device (rate limiting)
RATE_LIMIT_PER_MIN=120

# CORS origin — set to your frontend domain in production (default: *)
CORS_ORIGIN=*
